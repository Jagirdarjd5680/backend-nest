{
  "name": "lms-nestjs-backend",
  "version": "1.0.0",
  "description": "LMS Admin Panel NestJS Backend API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node scripts/dev.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev:fresh": "npm run start:dev",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "start:dev:nest": "powershell -NoProfile -Command \"(netstat -ano | Select-String ':5001\\s.*LISTENING') -replace '.*\\s(\\d+)$','$1' | Sort-Object -Unique | ForEach-Object { taskkill /PID $_ /F }\" & nest start --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@google/genai": "^2.15.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@types/pdfkit": "^0.17.6",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.3.1",
    "firebase-admin": "^14.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "mailchecker": "^6.0.21",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.2",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@prisma/client": "^5.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.0",
    "prisma": "^5.19.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
