// Persisted OTPs for email/phone verification — previously kept in an in-memory
// Map on OtpService, which lost every pending code on every server restart (this
// dev server alone gets restarted constantly) and would never work correctly
// across more than one backend instance in production.
model OtpCode {
  id        Int       @id @default(autoincrement())
  target    String // "verify:<email>" or a raw phone number — matches OtpService's existing key scheme
  code      String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([target])
  @@map("otp_codes")
}
